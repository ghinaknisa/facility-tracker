    {
      "name": "3. Complaints: create and read",
      "item": [
        {
          "name": "Reporter creates a complaint",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{reporter_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": "{{base_url}}/rest/v1/complaints",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reporter_id\": \"{{reporter_id}}\",\n  \"category_id\": \"{{category_id}}\",\n  \"location\": \"Building B, Room 204 (API test)\",\n  \"description\": \"Ceiling lamp flickers when switched on (API test).\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "const rows = pm.response.json();",
                  "const c = rows[0];",
                  "pm.test(\"Ticket code is generated\", function () { pm.expect(c.ticket_code).to.match(/^FC-\\d{3,}$/); });",
                  "pm.test(\"Status starts as New and priority is empty\", function () { pm.expect(c.status).to.eql(\"New\"); pm.expect(c.priority).to.be.null; });",
                  "pm.test(\"Reporter is the logged-in user\", function () { pm.expect(c.reporter_id).to.eql(pm.environment.get(\"reporter_id\")); });",
                  "pm.environment.set(\"complaint_id\", c.complaint_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Complaint with a too-short description is rejected (CHECK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
