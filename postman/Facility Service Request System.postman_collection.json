    {
      "name": "4. Admin: prioritize and assign",
      "item": [
        {
          "name": "Admin lists all complaints",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rest/v1/complaints?select=*&order=created_at.desc",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const rows = pm.response.json();",
                  "pm.test(\"Admin sees the reporter complaint\", function () { pm.expect(rows.map(function (r) { return r.complaint_id; })).to.include(Number(pm.environment.get(\"complaint_id\"))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin sets priority and assigns a technician",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
