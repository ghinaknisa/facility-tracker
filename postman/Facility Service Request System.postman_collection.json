            "url": "{{base_url}}/rest/v1/categories",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{new_category_name}}\",\n  \"description\": \"Created by Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "const rows = pm.response.json();",
                  "pm.test(\"Category is created and active\", function () { pm.expect(rows[0].name).to.eql(pm.environment.get(\"new_category_name\")); pm.expect(rows[0].is_active).to.eql(true); });",
                  "pm.environment.set(\"new_category_id\", rows[0].category_id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"new_category_name\", \"Test Category \" + Date.now());"
                ]
              }
