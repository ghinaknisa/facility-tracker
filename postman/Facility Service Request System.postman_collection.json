{
  "info": {
    "name": "Facility Service Request System - API Validation",
    "description": "Validates the Supabase Auth and REST (PostgREST) API: CRUD, Row Level Security and database triggers. Run the whole collection with the Collection Runner, in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as reporter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/v1/token?grant_type=password",
            "description": "Signs in the reporter account and saves its token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{reporter_email}}\",\n  \"password\": \"{{reporter_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Response contains an access token\", function () { pm.expect(j.access_token).to.be.a(\"string\").and.not.empty; });",
                  "pm.environment.set(\"reporter_token\", j.access_token);",
                  "pm.environment.set(\"reporter_id\", j.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/v1/token?grant_type=password",
            "description": "Signs in the admin account and saves its token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Response contains an access token\", function () { pm.expect(j.access_token).to.be.a(\"string\").and.not.empty; });",
                  "pm.environment.set(\"admin_token\", j.access_token);",
                  "pm.environment.set(\"admin_id\", j.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as technician",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/v1/token?grant_type=password",
            "description": "Signs in the technician account and saves its token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{technician_email}}\",\n  \"password\": \"{{technician_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Response contains an access token\", function () { pm.expect(j.access_token).to.be.a(\"string\").and.not.empty; });",
                  "pm.environment.set(\"technician_token\", j.access_token);",
                  "pm.environment.set(\"technician_id\", j.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong password is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/v1/token?grant_type=password",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{reporter_email}}\",\n  \"password\": \"definitely-wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"No access token is returned\", function () { pm.expect(pm.response.json().access_token).to.be.undefined; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Anonymous user cannot read complaints",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rest/v1/complaints?select=*",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Anonymous request is blocked or returns no rows\", function () { if (pm.response.code === 200) { pm.expect(pm.response.json()).to.have.lengthOf(0); } else { pm.expect([401,403]).to.include(pm.response.code); } });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Categories",
      "item": [
        {
          "name": "List categories (reporter)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{reporter_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rest/v1/categories?select=*&is_active=eq.true&order=name.asc",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const rows = pm.response.json();",
                  "pm.test(\"Seed categories exist\", function () { pm.expect(rows.length).to.be.at.least(1); });",
                  "pm.environment.set(\"category_id\", rows[0].category_id);"
                ]
